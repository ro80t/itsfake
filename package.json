{
  "name": "itsfake",
  "version": "0.0.0",
  "description": "Honeypot middleware for Hono, Next.js, and Nuxt that serves fake secrets at commonly-scanned paths (.env, wp-login.php, ...) to mislead attackers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ro80t/itsfake.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    },
    "./hono": {
      "import": "./dist/hono.mjs",
      "require": "./dist/hono.cjs",
      "types": "./dist/hono.d.mts"
    },
    "./next": {
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs",
      "types": "./dist/next.d.mts"
    },
    "./nuxt": {
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.cjs",
      "types": "./dist/nuxt.d.mts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/bun": "latest",
    "h3": "^1.15.11",
    "hono": "^4.13.8",
    "next": "^16.4.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "h3": "^1",
    "hono": "^4",
    "next": "^14 || ^15 || ^16",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
